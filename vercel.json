{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/config.yml",
      "destination": "/admin/config.yml"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!admin|api|assets|favicon|uploads|config\\.yml|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
